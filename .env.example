# Copie este arquivo para .env e preencha com os seus dados.
# O .env está no .gitignore e NÃO deve ser enviado ao GitHub.
# Usado pelo notebook Geracao_insights.ipynb e por src/carregar_banco.py (PostgreSQL).
# Defina estas variáveis no terminal antes de rodar (ex.: PowerShell: $env:DB_PASSWORD="...").
DB_NAME=ANP
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
